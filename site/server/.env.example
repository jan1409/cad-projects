# Copy to .env next to docker-compose.yml and fill in GITHUB_TOKEN. Keep .env private (chmod 600).

# Repository whose "site-*" releases hold the built site
GITHUB_REPO=jan1409/cad-projects
# Fine-grained personal access token: only this repository, permission "Contents: Read-only"
GITHUB_TOKEN=

# Minutes between update checks (0 = only when "Check for updates" is pressed)
UPDATE_INTERVAL_MIN=15
# Install new releases automatically (false = only show them; the button still installs)
AUTO_INSTALL=true
# Versions kept on disk, including the current one
KEEP_VERSIONS=3
# Stay on (or roll back to) one release, e.g. 2026.10.23-1412-abc1234; empty = follow the newest
PIN_VERSION=
